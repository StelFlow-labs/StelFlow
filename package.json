{
  "name": "stelflow",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @stelflow/web dev",
    "build": "pnpm --filter @stelflow/web build",
    "lint": "pnpm --filter @stelflow/web lint",
    "typecheck": "pnpm --filter @stelflow/web typecheck",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "contract:test": "cargo test --target aarch64-apple-darwin",
    "contract:build": "stellar contract build",
    "bindings": "node scripts/generate-bindings.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "mermaid": "11.16.1"
  }
}
