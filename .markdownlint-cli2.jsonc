{
  // Config for markdownlint-cli2 (docs.yml). Rules are tuned to this repo's existing prose rather
  // than the other way around — see CONTRIBUTING.md's "don't reformat 1,200 lines of prose" rule.
  // Full rule list: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,

    // The docs write long, discursive paragraphs by design (see CONTRIBUTING.md). A line-length
    // rule would either fight every paragraph in the repo or need constant per-line exceptions.
    "MD013": false,

    // Headings like "### 1. StelFlow Core (Soroban contract, Rust) — planned" repeat a numbering
    // style across architecture.md's Components section; duplicate-heading and increment rules
    // would flag structure that's intentional here.
    "MD024": { "siblings_only": true },

    // glossary.md is a flat definition list: one H1 title, then every term as an H3 with no H2
    // section headings in between. That's a deliberate structure, not a mistake, so heading
    // increment isn't a useful rule for this repo.
    "MD001": false,

    // Every table in these docs is written compact (`|---|---|`, no padding), not machine-aligned
    // to markdownlint's "compact"/"aligned" pipe style — measured at 94 hits against this repo's
    // tables with default rules, the definition of a rule that's wrong for this repo's style.
    "MD060": false,

    // concepts.md fences six plain-English accrual formulas (not real code) for readability;
    // tagging them "text" would be a language lie, and every shell snippet elsewhere in the repo
    // is already tagged `bash`. Not worth a mixed-motive rule to catch untagged fences that are
    // untagged on purpose.
    "MD040": false,

    // The README banner has to be a <picture> element. A README image renders inside an <img>,
    // which has no inherited text colour, so a single currentColor asset resolves to black and
    // disappears on GitHub's dark theme — the two-asset + prefers-color-scheme route is the only
    // one that works, and it is what issue #10 asks for. This allowlist is exactly the elements
    // that needs and nothing more, so stray HTML elsewhere in the prose is still caught.
    "MD033": { "allowed_elements": ["p", "picture", "source", "img", "a"] },

    // Follows from the same banner: the README's first line is that <picture> block rather than
    // the H1, which sits directly beneath it.
    "MD041": { "allow_preamble": true }
  },

  "globs": ["**/*.md"],

  // GitHub PR/issue templates intentionally open with an HTML comment instructing the author,
  // not a heading — that's how GitHub's "New PR"/"New issue" UI expects them to read.
  "ignores": [
    "**/node_modules/**",
    "**/.git/**",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/**",

    // Generated by `pnpm bindings` and gitignored. Linting a file the toolchain
    // rewrites on every run means fixing the same findings forever.
    "packages/stelflow-sdk/**",
    "docs/.vitepress/dist/**",
    "docs/.vitepress/cache/**"
  ]
}
